PORT=3000
DATABASE_URL=postgres://pets:pets@localhost:5432/pawhome
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=86400

# Администратор создаётся при старте, если такого email ещё нет
ADMIN_EMAIL=admin@pawhome.local
ADMIN_PASSWORD=admin12345

# true — при пустой базе добавить демо-животных
SEED_DEMO=true

# true — удалить схему при старте (только для e2e-тестов)
DB_DROP_SCHEMA=false
